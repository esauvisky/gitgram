# Copy to .env and fill in. Required unless marked optional.

# Telegram
GITGRAM_TELEGRAM_TOKEN=123456:bot-token
# One chat id, or several separated by commas; every card goes to each.
GITGRAM_CHAT_ID=-1001234567890
# webhook (needs GITGRAM_PUBLIC_URL and GITGRAM_TG_WEBHOOK_SECRET) or polling.
GITGRAM_TELEGRAM_MODE=webhook
GITGRAM_TG_WEBHOOK_SECRET=a-long-random-string

# GitLab
# Top-level group; every project under it (subgroups included) is accepted.
GITGRAM_GITLAB_GROUP=my-org
# X-Gitlab-Token GitLab sends with each delivery.
GITGRAM_WEBHOOK_SECRET=another-long-random-string
# Optional, read_api: diff stats, failure logs, artifacts, force-push detection, reconciler.
GITGRAM_GITLAB_TOKEN=
# Optional, api: sync-hooks and the Stop, Retry and Run buttons.
GITGRAM_GITLAB_HOOKS_TOKEN=
# Optional, default https://gitlab.com
# GITGRAM_GITLAB_URL=https://gitlab.example.com

# Server: the public URL GitLab and Telegram deliver to (GitLab uses /webhook/gitlab).
GITGRAM_PUBLIC_URL=https://hooks.example.com
# Optional, default :8080
# GITGRAM_LISTEN=:8080

# Optional tuning, with their defaults
# GITGRAM_LOG_LINES=10        # lines of a failed job's log on its card; 0 disables
# GITGRAM_MAX_COMMITS=10      # commits listed on a push card
# GITGRAM_DB=/data/gitgram.db
# GITGRAM_LOG_LEVEL=info      # debug, info, warn, error
# GITGRAM_LOG_FORMAT=text     # text or json
